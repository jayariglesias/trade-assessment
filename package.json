{
  "name": "trade-assessment",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "generate:api": "pnpm --filter backend generate:openapi && pnpm --filter @shared/api-contracts generate",
    "db:seed": "pnpm --filter backend prisma:seed",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "test": "turbo run test",
    "kill-ports": "kill-port 3000 3001"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
